# Copy this file to ".env" and fill in real values.
# NEVER commit .env — it is listed in .gitignore.

# --- PostgreSQL connection (Supabase or Neon) ---
# SQLAlchemy URL format:
#   postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# Supabase/Neon give you host, port (usually 5432), user, password and db name.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/canlog

# --- LLM API (used in Step 7 for the AI test report) ---
# Only needed later; leave the placeholder for now.
ANTHROPIC_API_KEY=your-key-here
